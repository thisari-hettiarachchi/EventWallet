rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    function isEventOwner(eventId) {
      return isAuthenticated() &&
        eventExists(eventId) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.userId == request.auth.uid;
    }

    function bookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function getBookingData(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        // Allow providers to send notifications to users
        allow create: if isAuthenticated();
      }

      match /saved_providers/{providerId} {
        allow read, create, delete: if isOwner(userId);
      }
    }

    // =========================
    // EVENTS
    // =========================
    match /events/{eventId} {

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if isAuthenticated();

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        // Allow providers to update 'spent' when accepting bookings
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spent','updatedAt'])
      );

      // SERVICES
      match /services/{serviceId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isEventOwner(eventId);
      }

      // SELECTED SERVICES
      match /selected_services/{serviceId} {
        allow read, write: if isAuthenticated() && isEventOwner(eventId);
      }

      match /tasks/{taskId} {
        allow read, write: if isAuthenticated();
      }

      match /guests/{guestId} {
        allow read, write: if isAuthenticated();
      }
    }

    // =========================
    // BOOKINGS
    // =========================
    match /bookings/{bookingId} {

      // Create booking (only user)
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Read booking
      allow read: if isAuthenticated() &&
        (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.providerId
        );

      // UPDATE LOGIC
      allow update: if isAuthenticated() && (
        // Provider can accept/reject/complete
        (
          request.auth.uid == resource.data.providerId &&
          request.resource.data.status in ['accepted', 'rejected', 'completed']
        )
        ||
        // User can cancel
        (
          request.auth.uid == resource.data.userId &&
          request.resource.data.status == 'cancelled'
        )
      ) &&

      // Allow updating of relevant status and tracking fields
      // FieldValue.delete() keys are also considered 'affected'
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt',
        'acceptedAt',
        'rejectedAt',
        'cancelledAt',
        'statusReason',
        'cancelledBy'
      ]);

      // Delete only by user
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;
    }

    // =========================
    // BOOKING CHATS
    // =========================
    match /booking_chats/{bookingId} {

      function isParticipant() {
        return isAuthenticated() &&
          (
            resource.data.userId == request.auth.uid ||
            resource.data.providerId == request.auth.uid
          );
      }

      function isParticipantOnCreate() {
        return isAuthenticated() &&
          (
            request.resource.data.userId == request.auth.uid ||
            request.resource.data.providerId == request.auth.uid
          );
      }

      allow list: if isAuthenticated();
      allow get: if isParticipant();
      allow create: if isParticipantOnCreate();
      allow update: if isParticipant();
      allow delete: if false;

      // MESSAGES
      match /messages/{messageId} {

        function isMessageParticipant() {
          return isAuthenticated() &&
            bookingExists(bookingId) &&
            (
              getBookingData(bookingId).userId == request.auth.uid ||
              getBookingData(bookingId).providerId == request.auth.uid
            );
        }

        allow read: if isMessageParticipant();

        allow create: if isMessageParticipant() &&
          request.resource.data.senderId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // =========================
    // EXPENSES
    // =========================
    match /expenses/{expenseId} {

      function isAssociatedBookingProvider() {
        // Here expenseId is often the bookingId
        return bookingExists(expenseId) &&
               getBookingData(expenseId).providerId == request.auth.uid;
      }

      function isExpenseCreator() {
        return isAuthenticated() &&
          resource.data.userId == request.auth.uid;
      }

      function isExpenseCreatorOnCreate() {
        return isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
      }

      allow read: if isAuthenticated();

      // Allow creation if the user is the owner OR the provider of the associated booking
      allow create: if isExpenseCreatorOnCreate() || isAssociatedBookingProvider();

      // Allow updates/deletes if the user is the owner OR the provider of the associated booking
      allow update, delete: if isExpenseCreator() || isAssociatedBookingProvider();
    }

    // =========================
    // SERVICE PROVIDERS
    // =========================
    match /{collection}/{providerId} {

      allow read: if collection in [
        'musicians',
        'photographers',
        'venues',
        'caterers',
        'service_providers'
      ];

      allow write: if isOwner(providerId) &&
        collection in [
          'musicians',
          'photographers',
          'venues',
          'caterers',
          'service_providers'
        ];

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwner(providerId);
      }

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;

        allow update, delete: if isOwner(reviewId);
      }

      match /notifications/{notificationId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isOwner(providerId);
      }
    }
  }
}
